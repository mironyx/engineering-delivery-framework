{
  "script": "gh-create-issue.sh",
  "argv": [
    "--title",
    "Add widget",
    "--body",
    "Line one\nLine two",
    "--add-to-board"
  ],
  "tracker_argv": [
    "create",
    "--title",
    "Add widget",
    "--body",
    "Line one\nLine two",
    "--add-to-board"
  ],
  "setup": {
    "project_env": true
  },
  "rules": [
    {
      "argv_prefix": [
        "issue",
        "list"
      ],
      "stdout": ""
    },
    {
      "argv_prefix": [
        "issue",
        "create"
      ],
      "stdout": "https://github.com/owner/repo/issues/42\n"
    },
    {
      "argv_prefix": [
        "project",
        "item-add"
      ],
      "stdout": "{\"id\":\"PVTI_new\"}\n"
    },
    {
      "argv_prefix": [
        "project",
        "item-edit"
      ],
      "stdout": ""
    }
  ],
  "compare": "exact",
  "stdout": "created:42\n",
  "stderr": "",
  "exit": 0
}
