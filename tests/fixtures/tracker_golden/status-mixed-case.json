{
  "script": "gh-project-status.sh",
  "argv": [
    "42",
    "In Progress"
  ],
  "tracker_argv": [
    "status",
    "42",
    "In Progress"
  ],
  "setup": {
    "project_env": true
  },
  "rules": [
    {
      "argv_prefix": [
        "api",
        "graphql"
      ],
      "stdout": "{\"data\": {\"repository\": {\"issue\": {\"number\": 42, \"title\": \"Some issue\", \"body\": \"Body\", \"state\": \"OPEN\", \"labels\": {\"nodes\": []}, \"projectItems\": {\"nodes\": [{\"id\": \"PVTI_item\", \"project\": {\"id\": \"PVT_abc\"}, \"fieldValues\": {\"nodes\": []}}]}}}}}\n"
    },
    {
      "argv_prefix": [
        "project",
        "item-edit"
      ],
      "stdout": ""
    }
  ],
  "compare": "exact",
  "stdout": "Issue #42 → In Progress\n",
  "stderr": "",
  "exit": 0
}
